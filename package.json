{
  "name": "root",
  "private": true,
  "version": "5.0.0",
  "workspaces": [
    "common",
    "output",
    "framework",
    "e2e",
    "clients/*",
    "platforms/*",
    "integrations/*",
    "examples/*"
  ],
  "scripts": {
    "setup:dev": "npm install && npm run build",
    "setup:cli": "lerna run setup:cli && npm run setup:dev",
    "clean": "lerna run rimraf",
    "build": "lerna run build --ignore @jovotech/examples-* --ignore @jovotech/e2e",
    "prettier": "lerna run prettier --ignore @jovotech/examples-*",
    "eslint": "lerna run eslint --ignore @jovotech/examples-* --ignore @jovotech/e2e",
    "rimraf": "lerna run rimraf --ignore @jovotech/examples-*",
    "test": "lerna run test --ignore @jovotech/examples-*",
    "version": "node scripts/update-peer-dependencies.js",
    "preparePublish": "npm install && npm run prettier && npm run eslint && npm run build && npm run test",
    "updateVersions:minor": "lerna version minor --yes --no-push --no-git-tag-version",
    "updateVersions:patch": "lerna version patch --yes --no-push --no-git-tag-version",
    "publishPackages": "lerna publish from-package --yes --no-verify-access"
  },
  "author": "jovotech",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "lerna": "8.1.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-toolbelt": "9.6.0",
    "typescript": "~5.3.0"
  },
  "dependencies": {},
  "overrides": {
    "typescript": "$typescript",
    "@types/lodash": "4.14.202",
    "@types/babel__traverse": "7.18.5",
    "@types/node": "$@types/node",
    "@types/jest": "$@types/jest"
  }
}
